{
  "name": "host-biiquiz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/with-root-env.js prisma generate --schema ../prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "node scripts/with-root-env.js prisma generate --schema ../prisma/schema.prisma",
    "prisma:migrate": "node scripts/with-root-env.js prisma migrate dev --schema ../prisma/schema.prisma",
    "prisma:deploy": "node scripts/with-root-env.js prisma migrate deploy --schema ../prisma/schema.prisma",
    "prisma:studio": "node scripts/with-root-env.js prisma studio --schema ../prisma/schema.prisma",
    "seed:test-users": "node scripts/create-test-users.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
