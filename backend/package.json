{
  "name": "biiquiz-backend-schema",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prisma:validate": "node scripts/with-env.js prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "node scripts/with-env.js prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "node scripts/with-env.js prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "node scripts/with-env.js prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:studio": "node scripts/with-env.js prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  }
}
