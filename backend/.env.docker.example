POSTGRES_DB=biiquiz
POSTGRES_USER=biiquiz
POSTGRES_PASSWORD=replace-with-a-strong-database-password
BACKEND_PORT=8000

DATABASE_URL=postgresql://biiquiz:replace-with-a-strong-database-password@db:5432/biiquiz
DIRECT_URL=postgresql://biiquiz:replace-with-a-strong-database-password@db:5432/biiquiz
AUTH_SECRET=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
DJANGO_SECURE_COOKIES=true
APP_BASE_URL=https://app.example.com

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=your-gmail@gmail.com
