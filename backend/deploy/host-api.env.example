DATABASE_URL=postgresql://biiquiz:replace-with-a-strong-password@127.0.0.1:5432/biiquiz?sslmode=prefer
DIRECT_URL=postgresql://biiquiz:replace-with-a-strong-password@127.0.0.1:5432/biiquiz?sslmode=prefer
AUTH_SECRET=replace-with-at-least-64-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=hostapi.biiquiz.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://host.biiquiz.com,https://hostapi.biiquiz.com
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DATABASE_CONN_MAX_AGE=60
APP_BASE_URL=https://host.biiquiz.com
GUNICORN_BIND=127.0.0.1:8765
GUNICORN_WORKERS=3
GUNICORN_THREADS=2

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=your-gmail@gmail.com
