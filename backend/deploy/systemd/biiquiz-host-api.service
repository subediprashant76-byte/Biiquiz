[Unit]
Description=biiQuiz Host Django API
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=biiquiz
Group=www-data
WorkingDirectory=/srv/biiquiz/backend
EnvironmentFile=/etc/biiquiz/host-api.env
RuntimeDirectory=biiquiz-host-api
RuntimeDirectoryMode=0755
ExecStartPre=/srv/biiquiz/backend/.venv/bin/python manage.py check --deploy
ExecStart=/srv/biiquiz/backend/.venv/bin/gunicorn --config gunicorn.conf.py biiquiz_api.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=45
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
